{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aizu",
  "version": "0.1.0",
  "identifier": "dev.aizu.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm bundle:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Aizu",
        "width": 900,
        "height": 650,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/aizu": "bin/aizu",
      "../../../assets/audio/aizu-pop.wav": "aizu-pop.wav"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
